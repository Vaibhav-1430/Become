# ==============================================================================
# BOSS STUDYOS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your project keys
# NEVER commit actual secrets or production keys to version control
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Public / Browser-Safe)
# Obtain from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ------------------------------------------------------------------------------
# 2. Supabase Server-Side Admin / Service Role (STRICTLY SERVER-ONLY - NEVER EXPOSE)
# Used for backend server administration, automated migrations, or service tasks.
# NEVER prefix with NEXT_PUBLIC_
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. Server-Side Cryptographic Security
# Used to encrypt per-user Gemini API keys via AES-256-GCM.
# Must be at least 32 characters (or 64-char hex string).
# ------------------------------------------------------------------------------
BYOK_ENCRYPTION_SECRET=your_32_to_64_char_cryptographic_secret_here

# ------------------------------------------------------------------------------
# 4. Local Server Port
# ------------------------------------------------------------------------------
PORT=3000
